# Copy to .env and fill in your values (do not commit .env)

# Supabase (production) or local PostgreSQL (development)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# API
API_TITLE=Facial Recognition Surveillance API
API_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Shared secret for edge nodes posting detections (must match local .env API_URL setup)
EDGE_API_KEY=change-me-to-a-long-random-string
