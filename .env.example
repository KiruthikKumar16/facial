# ============================================================
# SINGLE ROOT .env — All components read from this file.
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to git (it's already in .gitignore).
#
# Components that auto-load this root .env:
#   - backend/config.py        (FastAPI on Render/local)
#   - facial-recognition-dashboard/next.config.mjs  (Next.js/Vercel reads NEXT_PUBLIC_* vars)
#   - facial_recognition/*.py  (local edge CV node)
#   - scripts/*.ps1 / *.py     (utility scripts)
# ============================================================

# ---------------------------------------------------------------- 1. DATABASE (Supabase PostgreSQL + pgvector)
# Used by: backend (Render). Edge node uses API instead (direct DB optional).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---------------------------------------------------------------- 2. BACKEND API (Render / local FastAPI)
# Meta
API_TITLE=Facial Recognition Surveillance API
API_VERSION=1.0.0

# Server bind (local dev; Render sets PORT env automatically)
HOST=0.0.0.0
PORT=8000
DEBUG=False

# CORS: comma-separated list of allowed frontend origins
# Include localhost for dev + your exact Vercel production URL (no trailing slash!)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app

# Shared secret for edge nodes posting detections.
# MUST match across: (1) this file, (2) Render env vars, (3) any standalone edge node .env
EDGE_API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- 3. FRONTEND (Vercel / Next.js — NEXT_PUBLIC_* are exposed to browser!)
# These are PREFIXED so Next.js bundles them into client code.
# Value should be your Render backend URL (no trailing slash).
NEXT_PUBLIC_API_URL=https://your-app.onrender.com
NEXT_PUBLIC_WS_URL=wss://your-app.onrender.com

# For LOCAL frontend dev (npm run dev) override with:
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ---------------------------------------------------------------- 4. LOCAL EDGE CV NODE (webcam / RTSP pipelines)
# Backend URL for this PC's detection process to POST detections to.
# Local: http://localhost:8000   Production: https://your-app.onrender.com
API_URL=http://localhost:8000

# Optional annotated-video relay for the Vercel dashboard. Set API_URL above
# to your Render URL on the computer running the local recognition process.
# The same EDGE_API_KEY must be configured in Render.
EDGE_STREAM_FPS=8
EDGE_STREAM_JPEG_QUALITY=75

# (Optional) Direct DB write from edge — normally unused, detections go via REST API.
# DATABASE_URL=<same as section 1 if needed>
