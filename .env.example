# Edge node environment (copy to .env in repo root before running main_cpu.py / main.py)
# Do not commit .env

# Render backend URL (no trailing slash)
API_URL=https://your-app.onrender.com

# Must match EDGE_API_KEY set on Render
EDGE_API_KEY=change-me-to-a-long-random-string

# Optional: direct DB logging from edge (usually detections go via API instead)
# DATABASE_URL=postgresql://postgres:...@db....supabase.co:5432/postgres
